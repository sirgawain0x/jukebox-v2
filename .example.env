NEXT_PUBLIC_URL=
# Wallet address for receiving Base Pay payments (AI image generation)
# Required for playlist creation with AI-generated cover art
NEXT_PUBLIC_WALLET_ADDRESS=0x1Fde40a4046Eda0cA0539Dd6c77ABF8933B94260

# VAPID keys for web push notifications
# Generate using: npm install -g web-push && web-push generate-vapid-keys
# Both keys are server-side only (no NEXT_PUBLIC_ prefix)
# The public key is served to clients via /api/vapid/public-key endpoint
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: Email address for VAPID subject (format: mailto:your-email@example.com)
VAPID_SUBJECT=mailto:your-email@example.com